# Keyless local UI preview. Set to false after configuring the Dify credentials.
NEXT_PUBLIC_DEMO_MODE=true
# Dify web app ID
NEXT_PUBLIC_APP_ID=
# Create this key in the Dify console. Never commit a real key to Git.
NEXT_PUBLIC_APP_KEY=
# Dify API URL prefix
NEXT_PUBLIC_API_URL=https://api.dify.ai/v1
